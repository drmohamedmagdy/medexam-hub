generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  BASIC
  PRO
  PREMIUM
}

enum Difficulty {
  BEGINNER
  STUDENT
  INTERN
  RESIDENT
  SPECIALIST
  CONSULTANT
  BOARD
}

enum ExamMode {
  PRACTICE
  EXAM
}

enum QuestionFormat {
  MCQ
  TRUE_FALSE
  SHORT_NOTES
}

enum ExamStatus {
  GENERATING
  READY
  IN_PROGRESS
  COMPLETED
  FAILED
}

model User {
  id                    String        @id @default(cuid())
  email                 String        @unique
  emailVerifiedAt       DateTime?
  name                  String?
  passwordHash          String
  plan                  Plan          @default(FREE)
  planStartedAt         DateTime?
  planExpiresAt         DateTime?
  planCancelledAt       DateTime?
  // Email preferences
  emailMarketing        Boolean       @default(true)
  emailReminders        Boolean       @default(true)
  // Achievement progress — JSON array of unlocked achievement ids
  achievements          String?
  // Referral / credits system
  referralCode          String?       @unique
  referredByUserId      String?
  creditsBalance        Int           @default(0)
  // Last sent timestamps so the daily cron doesn't double-send within a window
  lastReminderSentAt    DateTime?
  lastReengagementAt    DateTime?
  // Per-user defaults remembered from the last exam they generated
  defaultGenerationMode String?
  defaultSpecialty      String?
  defaultTopic          String?
  defaultExamType       String?
  defaultDifficulty     Difficulty?
  defaultMode           ExamMode?
  defaultLanguage       String?
  defaultNumQuestions   Int?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  exams            Exam[]
  usage            UsageLog[]
  sessions         AuthSession[]
  payments         PaymentOrder[]
  fileUploads      FileUpload[]
  emailLogs        EmailLog[]
  promoRedemptions PromoRedemption[]
  notifications    Notification[]

  referredBy       User?               @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals        User[]              @relation("UserReferrals")
  creditTransactions CreditTransaction[]
  bonusGrants      BonusGrant[]
}

model CreditTransaction {
  id              String   @id @default(cuid())
  userId          String
  // Positive = credits earned, negative = credits spent.
  amount          Int
  // signup_bonus | referral_commission | redemption_discount | redemption_refund |
  // redemption_questions | redemption_files | manual_adjust
  type            String
  description     String?
  // For commission: the user whose payment caused this credit award.
  referredUserId  String?
  // For redemptions: the order the credits were applied to.
  paymentOrderId  String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([paymentOrderId])
}

// One row per bonus quota purchase. Active for the user's current
// `yearMonth` bucket — matches how UsageLog and FileUpload bucket
// monthly usage, so bonuses naturally expire when the calendar month
// rolls over.
model BonusGrant {
  id           String   @id @default(cuid())
  userId       String
  // "questions" | "files"
  kind         String
  amount       Int
  creditsSpent Int
  yearMonth    String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, yearMonth, kind])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  category  String    // achievement | system | reminder | broadcast
  title     String
  body      String?
  href      String?
  emoji     String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model LibraryResource {
  id            String   @id @default(cuid())
  title         String
  description   String?
  category      String   // freeform tag like "Cardiology", "USMLE Step 1", "Anatomy"
  filename      String
  mimeType      String
  sizeBytes     Int
  fileUrl       String   // public Vercel Blob URL
  filePathname  String   // pathname inside the Blob store (used for delete)
  coverUrl      String?  // optional book/document cover image URL (Vercel Blob)
  coverPathname String?  // pathname inside the Blob store (used for delete)
  uploadedBy    String   // admin user id who uploaded it
  downloadCount Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isPublished, createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String
  toEmail   String
  subject   String
  category  String   // welcome | renewal_7d | renewal_1d | expired | reengagement | broadcast
  sentAt    DateTime @default(now())
  error     String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([category, sentAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Exam {
  id             String         @id @default(cuid())
  userId         String
  title          String
  specialty      String?
  topic          String?
  examType       String?
  sourceFileId   String?
  difficulty     Difficulty
  mode           ExamMode       @default(PRACTICE)
  questionFormat QuestionFormat @default(MCQ)
  status         ExamStatus     @default(GENERATING)
  numQuestions Int
  timeLimitSec Int?
  createdAt    DateTime   @default(now())
  startedAt    DateTime?
  submittedAt  DateTime?
  scorePct     Float?

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions    Question[]
  sourceFile   FileUpload? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model FileUpload {
  id            String   @id @default(cuid())
  userId        String
  filename      String
  mimeType      String
  sizeBytes     Int
  charCount     Int
  extractedText String
  yearMonth     String
  // Optional AI-generated summary of the file contents, rendered as a PDF
  // and stored on Vercel Blob. summaryText keeps the raw markdown so we can
  // regenerate the PDF without another OpenAI call.
  summaryText      String?
  summaryUrl       String?
  summaryPathname  String?
  summaryCreatedAt DateTime?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exams         Exam[]

  @@index([userId, yearMonth])
  @@index([userId, createdAt])
}

model Question {
  id            String   @id @default(cuid())
  examId        String
  orderIndex    Int
  prompt        String
  // For MCQ + TRUE_FALSE: JSON-encoded option list and the correct option id.
  // For SHORT_NOTES: optionsJson is "[]" and correctId is "" (unused).
  optionsJson   String
  correctId     String
  // Explanation appears on every question type (the "why" of the answer).
  explanation   String
  learningPoint String?
  // For SHORT_NOTES only: an ideal short-answer the user can compare against.
  modelAnswer   String?
  // User's selection — option id for MCQ/TF, free text for SHORT_NOTES.
  selectedId    String?
  selectedText  String?
  // Auto-graded for MCQ/TF; null for SHORT_NOTES (self-assessed).
  isCorrect     Boolean?

  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, orderIndex])
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  count     Int      @default(1)
  yearMonth String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, yearMonth])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  CARD
  VODAFONE_CASH
  INSTAPAY
}

model PaymentOrder {
  id              String        @id @default(cuid())
  userId          String
  plan            Plan
  amountCents     Int
  currency        String        @default("EGP")
  paymentMethod   PaymentMethod @default(CARD)
  paymobOrderId   String?       @unique
  paymobTxId      String?       @unique
  status          PaymentStatus @default(PENDING)
  // For manual payments (Vodafone Cash / Instapay): a screenshot of the
  // transaction the user uploaded, plus admin review metadata.
  proofImageUrl      String?
  proofImagePathname String?
  proofRef           String? // legacy, kept for already-submitted payments
  proofNote          String?
  reviewedAt         DateTime?
  reviewedBy         String?
  rejectionReason    String?
  promoCodeId     String?
  promoCodeUsed   String?
  originalCents   Int?
  // Credits applied to this order (in EGP, since 1 credit = 1 EGP off).
  // Deducted from User.creditsBalance at order creation; refunded if
  // the order is rejected/failed.
  creditsApplied  Int           @default(0)
  createdAt       DateTime      @default(now())
  paidAt          DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode       PromoCode?       @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  redemption      PromoRedemption?

  @@index([userId, createdAt])
  @@index([promoCodeId])
  @@index([status, paymentMethod])
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

model PromoCode {
  id              String            @id @default(cuid())
  code            String            @unique
  discountType    PromoDiscountType
  discountValue   Int
  applicablePlans String
  maxUses         Int?
  maxUsesPerUser  Int               @default(1)
  expiresAt       DateTime?
  isActive        Boolean           @default(true)
  paymobLinks     String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  redemptions     PromoRedemption[]
  paymentOrders   PaymentOrder[]

  @@index([isActive])
}

model PromoRedemption {
  id             String   @id @default(cuid())
  promoCodeId    String
  userId         String
  plan           Plan
  originalCents  Int
  finalCents     Int
  paymentOrderId String?  @unique
  redeemedAt     DateTime @default(now())

  promoCode      PromoCode      @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentOrder   PaymentOrder?  @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@index([promoCodeId])
  @@index([userId, promoCodeId])
}
