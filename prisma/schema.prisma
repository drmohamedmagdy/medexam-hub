generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  BASIC
  PRO
  PREMIUM
  RESEARCHER
}

enum Difficulty {
  BEGINNER
  STUDENT
  INTERN
  RESIDENT
  SPECIALIST
  CONSULTANT
  BOARD
}

enum ExamMode {
  PRACTICE
  EXAM
}

enum QuestionFormat {
  MCQ
  TRUE_FALSE
  SHORT_NOTES
}

enum ExamStatus {
  GENERATING
  READY
  IN_PROGRESS
  COMPLETED
  FAILED
}

model User {
  id                    String        @id @default(cuid())
  email                 String        @unique
  emailVerifiedAt       DateTime?
  name                  String?
  passwordHash          String
  plan                  Plan          @default(FREE)
  planStartedAt         DateTime?
  planExpiresAt         DateTime?
  planCancelledAt       DateTime?
  // Email preferences
  emailMarketing        Boolean       @default(true)
  emailReminders        Boolean       @default(true)
  // Achievement progress — JSON array of unlocked achievement ids
  achievements          String?
  // Referral / credits system
  referralCode          String?       @unique
  referredByUserId      String?
  creditsBalance        Int           @default(0)
  // Last sent timestamps so the daily cron doesn't double-send within a window
  lastReminderSentAt    DateTime?
  lastReengagementAt    DateTime?
  // Per-user defaults remembered from the last exam they generated
  defaultGenerationMode String?
  defaultSpecialty      String?
  defaultTopic          String?
  defaultExamType       String?
  defaultDifficulty     Difficulty?
  defaultMode           ExamMode?
  defaultLanguage       String?
  defaultNumQuestions   Int?
  // Public profile bits. avatarUrl is a Vercel Blob link; avatarPathname
  // is kept for delete. profilePublic gates whether non-friends can view
  // /u/<id>. bio is plain text up to ~1000 chars.
  avatarUrl             String?
  avatarPathname        String?
  bio                   String?
  profilePublic         Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  exams            Exam[]
  usage            UsageLog[]
  sessions         AuthSession[]
  payments         PaymentOrder[]
  fileUploads      FileUpload[]
  emailLogs        EmailLog[]
  promoRedemptions PromoRedemption[]
  notifications    Notification[]

  referredBy       User?               @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals        User[]              @relation("UserReferrals")
  creditTransactions CreditTransaction[]
  bonusGrants      BonusGrant[]

  // Community
  ownedGroups      Group[]             @relation("GroupOwner")
  groupMemberships GroupMember[]
  invitesSent      GroupInvite[]       @relation("InvitesSent")
  posts            Post[]
  comments         PostComment[]

  // Research Assistant
  researchProjects ResearchProject[]

  // Standalone Statistics tool — separate from the research feature so
  // users who only need to crunch a CSV don't have to spin up a project.
  statsWorkspace   StatsWorkspace?

  // Direct messaging
  sentMessages     Message[]   @relation("MessageSender")
  receivedMessages Message[]   @relation("MessageReceiver")

  // Profile media (images / videos shown on /u/<id>)
  profileMedia     ProfileMedia[]

  // Group join requests sent by this user
  joinRequests     GroupJoinRequest[] @relation("RequesterJoinRequests")
  reviewedRequests GroupJoinRequest[] @relation("ReviewerJoinRequests")
}

model ProfileMedia {
  id           String   @id @default(cuid())
  userId       String
  // "image" | "video"
  kind         String
  url          String
  pathname     String   // Vercel Blob pathname for delete
  mimeType     String
  sizeBytes    Int
  caption      String?
  thumbnailUrl String?  // optional poster for videos
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  body       String
  sentAt     DateTime @default(now())
  readAt     DateTime?

  sender   User @relation("MessageSender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, sentAt])
  @@index([receiverId, readAt])
}

model GroupJoinRequest {
  id         String   @id @default(cuid())
  groupId    String
  userId     String
  message    String?
  // "pending" | "approved" | "rejected"
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  decidedAt  DateTime?
  decidedBy  String?

  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requester User   @relation("RequesterJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User?  @relation("ReviewerJoinRequests", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
  @@index([groupId, status])
}

model CreditTransaction {
  id              String   @id @default(cuid())
  userId          String
  // Positive = credits earned, negative = credits spent.
  amount          Int
  // signup_bonus | referral_commission | redemption_discount | redemption_refund |
  // redemption_questions | redemption_files | manual_adjust
  type            String
  description     String?
  // For commission: the user whose payment caused this credit award.
  referredUserId  String?
  // For redemptions: the order the credits were applied to.
  paymentOrderId  String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([paymentOrderId])
}

// One row per bonus quota purchase. Bonus quota is a perpetual pool
// that drains only when the user actually exceeds their plan's monthly
// quota — so users can stockpile questions/files across months instead
// of losing them. `yearMonth` is kept for analytics (when the grant
// was bought) but is NOT used to filter availability.
model BonusGrant {
  id           String   @id @default(cuid())
  userId       String
  // "questions" | "files"
  kind         String
  // Total units this grant added.
  amount       Int
  // Units already drained by overflow usage. The grant is fully used
  // when `consumed == amount`; drained FIFO across grants.
  consumed     Int      @default(0)
  creditsSpent Int
  yearMonth    String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([userId, yearMonth, kind])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  category  String    // achievement | system | reminder | broadcast
  title     String
  body      String?
  href      String?
  emoji     String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Course {
  id              String   @id @default(cuid())
  title           String
  description     String?
  category        String   // freeform tag like "Cardiology", "USMLE Step 1", "Wound Care"
  // Video file on Vercel Blob
  videoFilename   String
  videoMimeType   String
  videoSizeBytes  Int
  videoUrl        String   // public Vercel Blob URL
  videoPathname   String   // pathname inside Blob (used for delete)
  durationSec     Int?     // optional, set if known
  // Optional thumbnail image
  thumbnailUrl      String?
  thumbnailPathname String?
  uploadedBy      String   // admin user id who uploaded it
  viewCount       Int      @default(0)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([isPublished, createdAt])
}

model LibraryResource {
  id            String   @id @default(cuid())
  title         String
  description   String?
  category      String   // freeform tag like "Cardiology", "USMLE Step 1", "Anatomy"
  filename      String
  mimeType      String
  sizeBytes     Int
  fileUrl       String   // public Vercel Blob URL
  filePathname  String   // pathname inside the Blob store (used for delete)
  coverUrl      String?  // optional book/document cover image URL (Vercel Blob)
  coverPathname String?  // pathname inside the Blob store (used for delete)
  uploadedBy    String   // admin user id who uploaded it
  downloadCount Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isPublished, createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String
  toEmail   String
  subject   String
  category  String   // welcome | renewal_7d | renewal_1d | expired | reengagement | broadcast
  sentAt    DateTime @default(now())
  error     String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([category, sentAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Exam {
  id             String         @id @default(cuid())
  userId         String
  title          String
  specialty      String?
  topic          String?
  examType       String?
  sourceFileId   String?
  difficulty     Difficulty
  mode           ExamMode       @default(PRACTICE)
  questionFormat QuestionFormat @default(MCQ)
  status         ExamStatus     @default(GENERATING)
  numQuestions Int
  // JSON array of QuestionFormat values when the exam mixes multiple
  // formats (e.g. ["MCQ","TRUE_FALSE","SHORT_NOTES"]). Null on single-format
  // exams — `questionFormat` is the source of truth in that case.
  formatsAllowedJson String?
  timeLimitSec Int?
  createdAt    DateTime   @default(now())
  startedAt    DateTime?
  submittedAt  DateTime?
  scorePct     Float?

  // Share link (the master exam can be taken by other users — questions
  // are copied to a fork Exam owned by each taker). Only set on the master.
  shareToken     String?    @unique
  // When the user takes someone else's shared exam, this points back at
  // the master so the creator can see all attempts ranked.
  sharedFromId   String?

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions    Question[]
  sourceFile   FileUpload? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  sharedFrom   Exam?       @relation("ExamShares", fields: [sharedFromId], references: [id], onDelete: Cascade)
  sharedAttempts Exam[]    @relation("ExamShares")

  @@index([userId, createdAt])
  @@index([sharedFromId])
}

model FileUpload {
  id            String   @id @default(cuid())
  userId        String
  filename      String
  mimeType      String
  sizeBytes     Int
  charCount     Int
  extractedText String
  yearMonth     String
  // Optional AI-generated summary of the file contents, rendered as a PDF
  // and stored on Vercel Blob. summaryText keeps the raw markdown so we can
  // regenerate the PDF without another OpenAI call.
  summaryText      String?
  summaryUrl       String?
  summaryPathname  String?
  summaryCreatedAt DateTime?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exams         Exam[]

  @@index([userId, yearMonth])
  @@index([userId, createdAt])
}

model Question {
  id            String   @id @default(cuid())
  examId        String
  orderIndex    Int
  prompt        String
  // Per-question format. For single-format exams every Question shares the
  // exam's format; for mixed-format exams (Exam.formatsAllowedJson set) each
  // Question carries its own type so the take-exam UI can render the right
  // controls per question.
  format        QuestionFormat @default(MCQ)
  // For MCQ + TRUE_FALSE: JSON-encoded option list and the correct option id.
  // For SHORT_NOTES: optionsJson is "[]" and correctId is "" (unused).
  optionsJson   String
  correctId     String
  // Explanation appears on every question type (the "why" of the answer).
  explanation   String
  learningPoint String?
  // For SHORT_NOTES only: an ideal short-answer the user can compare against.
  modelAnswer   String?
  // User's selection — option id for MCQ/TF, free text for SHORT_NOTES.
  selectedId    String?
  selectedText  String?
  // Auto-graded for MCQ/TF; null for SHORT_NOTES (self-assessed).
  isCorrect     Boolean?

  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, orderIndex])
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  count     Int      @default(1)
  yearMonth String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, yearMonth])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  CARD
  VODAFONE_CASH
  INSTAPAY
}

model PaymentOrder {
  id              String        @id @default(cuid())
  userId          String
  plan            Plan
  amountCents     Int
  currency        String        @default("EGP")
  paymentMethod   PaymentMethod @default(CARD)
  paymobOrderId   String?       @unique
  paymobTxId      String?       @unique
  status          PaymentStatus @default(PENDING)
  // For manual payments (Vodafone Cash / Instapay): a screenshot of the
  // transaction the user uploaded, plus admin review metadata.
  proofImageUrl      String?
  proofImagePathname String?
  proofRef           String? // legacy, kept for already-submitted payments
  proofNote          String?
  reviewedAt         DateTime?
  reviewedBy         String?
  rejectionReason    String?
  promoCodeId     String?
  promoCodeUsed   String?
  originalCents   Int?
  // Credits applied to this order (in EGP, since 1 credit = 1 EGP off).
  // Deducted from User.creditsBalance at order creation; refunded if
  // the order is rejected/failed.
  creditsApplied  Int           @default(0)
  // When non-null, this is a one-off top-up purchase, not a plan upgrade.
  // Approved top-ups grant bonus units (research_projects / stats_analyses)
  // without touching the user's plan / expiry. Values:
  //   "RESEARCH_PROJECT" — adds topupAmount to research_projects pool
  //   "STATS_ANALYSIS"   — adds topupAmount to stats_analyses pool
  topupKind       String?
  topupAmount     Int           @default(1)
  createdAt       DateTime      @default(now())
  paidAt          DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode       PromoCode?       @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  redemption      PromoRedemption?

  @@index([userId, createdAt])
  @@index([promoCodeId])
  @@index([status, paymentMethod])
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

model PromoCode {
  id              String            @id @default(cuid())
  code            String            @unique
  discountType    PromoDiscountType
  discountValue   Int
  applicablePlans String
  maxUses         Int?
  maxUsesPerUser  Int               @default(1)
  expiresAt       DateTime?
  isActive        Boolean           @default(true)
  paymobLinks     String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  redemptions     PromoRedemption[]
  paymentOrders   PaymentOrder[]

  @@index([isActive])
}

model PromoRedemption {
  id             String   @id @default(cuid())
  promoCodeId    String
  userId         String
  plan           Plan
  originalCents  Int
  finalCents     Int
  paymentOrderId String?  @unique
  redeemedAt     DateTime @default(now())

  promoCode      PromoCode      @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentOrder   PaymentOrder?  @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@index([promoCodeId])
  @@index([userId, promoCodeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Community
// ─────────────────────────────────────────────────────────────────────────────

enum PostKind {
  POST
  QUESTION
  ARTICLE
}

model Group {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  // Public groups appear in the discoverable list and any logged-in user
  // can join. Private groups are invite-only and don't appear in the list.
  isPublic    Boolean  @default(false)
  inviteCode  String   @unique
  coverUrl    String?
  createdAt   DateTime @default(now())

  owner       User     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  invites     GroupInvite[]
  posts       Post[]
  joinRequests GroupJoinRequest[]

  @@index([ownerId])
  @@index([isPublic, createdAt])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  // "owner" | "admin" | "member" — owner is the creator, admins can also
  // delete posts and invite. Members can post and comment.
  role     String   @default("member")
  joinedAt DateTime @default(now())

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupInvite {
  id           String    @id @default(cuid())
  groupId      String
  invitedById  String
  email        String
  acceptedAt   DateTime?
  acceptedBy   String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy    User      @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([groupId])
}

model Post {
  id            String   @id @default(cuid())
  authorId      String
  // null = public feed; otherwise the post belongs to that group only.
  groupId       String?
  kind          PostKind @default(POST)
  // ARTICLE/QUESTION usually have a title; POST is allowed without one.
  title         String?
  body          String
  imageUrl      String?
  imagePathname String?
  linkUrl       String?
  linkLabel     String?
  // Set after the daily digest email goes out so we don't re-send.
  digestSentAt  DateTime?
  // Set after a public-group post triggers a real-time fan-out email so
  // the per-group 30-min throttle can detect "already announced" posts.
  groupAnnouncedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group         Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  comments      PostComment[]

  @@index([groupId, createdAt])
  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([groupId, groupAnnouncedAt])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Research Assistant — Phase 1
// ─────────────────────────────────────────────────────────────────────────────

enum ResearchKind {
  PROTOCOL
  THESIS
  MANUSCRIPT
  SYSTEMATIC_REVIEW
}

model ResearchProject {
  id            String   @id @default(cuid())
  userId        String
  kind          ResearchKind
  title         String
  specialty     String?
  studyType     String?
  sampleSize    Int?
  population    String?
  university    String?
  language      String   @default("English")
  // "vancouver" | "apa" | "mla"
  citationStyle String   @default("vancouver")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections ResearchSection[]
  files    ResearchFile[]
  analyses ResearchAnalysis[]

  @@index([userId, createdAt])
}

model ResearchSection {
  id          String    @id @default(cuid())
  projectId   String
  // Section kind. Free-form because each ResearchKind has its own set:
  //   PROTOCOL: introduction, lit_review, aim, questions, methodology,
  //             inclusion_exclusion, ethics, stats_plan, references
  //   THESIS:   introduction, lit_review, patients_methods, results,
  //             discussion, conclusion, references
  //   MANUSCRIPT: title_page, abstract, keywords, introduction,
  //               materials_methods, results, discussion, conclusion,
  //               references, acknowledgments, conflicts_funding
  //   SYSTEMATIC_REVIEW: abstract_pico, introduction, sr_methods,
  //                      prisma_flow, sr_results, discussion, conclusion,
  //                      references
  kind         String
  title        String
  content      String
  // For sections that carry structured data (e.g. PRISMA flow numbers).
  // JSON string. Null for normal prose sections.
  metadataJson String?
  orderIndex   Int
  generatedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, orderIndex])
  @@unique([projectId, kind])
  @@index([projectId])
}

// One row per saved statistical analysis on a project. The user picks
// a kind (descriptives, group comparison, correlation, histogram) and
// the columns to use; the server runs the computation against the
// chosen file's CSV text and stores the result. Charts get rendered
// to SVG and stored alongside the JSON so the editor can show them
// without recomputing.
model ResearchAnalysis {
  id         String   @id @default(cuid())
  projectId  String
  // Optional — null if the analysis came from raw user input rather
  // than an attached CSV.
  fileId     String?
  // "descriptives" | "compare_means" | "correlation" | "histogram"
  kind       String
  title      String
  // Params: which columns, etc. Matches the kind-specific shape.
  configJson String
  // Computed numeric result (descriptive rows, t-test stats, etc.)
  resultJson String?
  // Rendered chart, if any.
  resultSvg  String?
  computedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project    ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file       ResearchFile?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

// Data files (CSV / Excel-as-text / Word / PDF) attached to a research
// project. The extracted text is fed into AI prompts so the generated
// sections (especially Statistical Analysis Plan and Results) can talk
// about the actual data.
model ResearchFile {
  id            String   @id @default(cuid())
  projectId     String
  filename      String
  mimeType      String
  sizeBytes     Int
  charCount     Int
  extractedText String
  // Optional public URL on Vercel Blob — kept so the user can re-download
  // their original file. Pathname is used for delete.
  fileUrl       String?
  filePathname  String?
  createdAt     DateTime @default(now())

  project       ResearchProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analyses      ResearchAnalysis[]

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Standalone Statistics tool
//   One workspace per user, holds a single CSV at a time + a list of
//   analyses run against it. Replacing the CSV deletes all existing
//   analyses (column shapes change). Independent of the research feature.
// ─────────────────────────────────────────────────────────────────────────────

model StatsWorkspace {
  id            String   @id @default(cuid())
  userId        String   @unique
  // Legacy single-file fields — kept nullable for back-compat after the
  // multi-file migration. New code reads `files` instead. A future
  // migration can drop these once we're sure the backfill stuck.
  filename      String?
  mimeType      String?
  sizeBytes     Int?
  charCount     Int?
  extractedText String?
  fileUrl       String?
  filePathname  String?
  uploadedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  files         StatsFile[]
  analyses      StatsAnalysis[]
}

model StatsFile {
  id            String   @id @default(cuid())
  workspaceId   String
  filename      String
  mimeType      String
  sizeBytes     Int
  charCount     Int
  extractedText String
  fileUrl       String?
  filePathname  String?
  uploadedAt    DateTime @default(now())

  workspace     StatsWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analyses      StatsAnalysis[]

  @@index([workspaceId])
}

model StatsAnalysis {
  id           String   @id @default(cuid())
  workspaceId  String
  // Optional: which uploaded file this analysis was computed from. SetNull
  // on file delete so removing one file doesn't wipe analyses that
  // reference it (the result rows survive as orphaned records).
  fileId       String?
  // "descriptives" | "compare_means" | "correlation" | "histogram" | …
  kind         String
  title        String
  configJson   String
  resultJson   String?
  resultSvg    String?
  computedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    StatsWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file         StatsFile?     @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([fileId])
}
