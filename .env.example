# Database — SQLite for dev. Switch to a Postgres URL for prod.
DATABASE_URL="file:./dev.db"

# Required for AI exam generation
OPENAI_API_KEY=
# Optional override; defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Required in production: a long random string used to sign payment-return tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Paymob — current Quick-Pay short-links live in src/lib/paymob.ts.
# Once the full Intention-API integration ships (see src/lib/paymob-intention.ts),
# fill these in from the Paymob dashboard:
#
#   Settings → API Keys (Account Info):
# PAYMOB_API_KEY=         # legacy JWT auth, still useful for ecommerce/order create
# PAYMOB_SECRET_KEY=      # egy_sk_test_… or egy_sk_live_… — primary auth for Intention API
# PAYMOB_PUBLIC_KEY=      # egy_pk_test_… or egy_pk_live_… — used in checkout redirect
# PAYMOB_HMAC_SECRET=     # long hex string — verifies webhook signatures
#
#   Developers → Payment Integrations (one ID per method you've created):
# PAYMOB_INTEGRATION_ID_CARD=
# PAYMOB_INTEGRATION_ID_WALLET=
# PAYMOB_INTEGRATION_ID_INSTAPAY=
#
#   Other:
# PAYMOB_ENV=test         # test | live — controls test-mode banner + which keys to expect

# Optional: intro video shown on the home hero "Watch demo" lightbox
# AND used as a fallback on /signup + /login if those don't have a
# more specific source set below. Accepts YouTube (watch / youtu.be /
# shorts / embed), Vimeo, or any direct .mp4 URL.
NEXT_PUBLIC_INTRO_VIDEO_URL=

# Optional: distinct videos per auth page. If unset, the resolver
# tries /public/demo/signup.mp4 (or login.mp4), then falls through to
# NEXT_PUBLIC_INTRO_VIDEO_URL / hero.mp4.
NEXT_PUBLIC_SIGNUP_VIDEO_URL=
NEXT_PUBLIC_LOGIN_VIDEO_URL=
