# Database — SQLite for dev. Switch to a Postgres URL for prod.
DATABASE_URL="file:./dev.db"

# Required for AI exam generation
OPENAI_API_KEY=
# Optional override; defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Required in production: a long random string used to sign payment-return tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Paymob payment links are configured in src/lib/paymob.ts.
# When you wire up the real Paymob API later, the keys you'll need are:
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=
# PAYMOB_HMAC_SECRET=

# Optional: intro video shown on the home hero "Watch demo" lightbox
# AND used as a fallback on /signup + /login if those don't have a
# more specific source set below. Accepts YouTube (watch / youtu.be /
# shorts / embed), Vimeo, or any direct .mp4 URL.
NEXT_PUBLIC_INTRO_VIDEO_URL=

# Optional: distinct videos per auth page. If unset, the resolver
# tries /public/demo/signup.mp4 (or login.mp4), then falls through to
# NEXT_PUBLIC_INTRO_VIDEO_URL / hero.mp4.
NEXT_PUBLIC_SIGNUP_VIDEO_URL=
NEXT_PUBLIC_LOGIN_VIDEO_URL=
