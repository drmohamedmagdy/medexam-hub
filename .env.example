# Database — SQLite for dev. Switch to a Postgres URL for prod.
DATABASE_URL="file:./dev.db"

# Required for AI exam generation
OPENAI_API_KEY=
# Optional override; defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Required in production: a long random string used to sign payment-return tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Paymob payment links are configured in src/lib/paymob.ts.
# When you wire up the real Paymob API later, the keys you'll need are:
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=
# PAYMOB_HMAC_SECRET=

# Optional: intro video shown on /signup, /login, and the home hero
# "Watch demo" lightbox. Accepts YouTube (watch / youtu.be / shorts /
# embed), Vimeo, or any direct .mp4 URL. Leave blank to fall back to
# /public/demo/hero.mp4 (or the gradient placeholder if that's missing).
NEXT_PUBLIC_INTRO_VIDEO_URL=
